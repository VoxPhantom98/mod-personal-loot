+bool Player::ClaimJournalGold(Loot* loot, uint32 amount)
+{
+    if (!loot->gold)
+        return true;
+    if (!MoneyFits(this, amount) || loot->GetJournalEventId().empty() || !FlushJournalInventory())
+        return false;
+    auto transaction = CharacterDatabase.BeginTransaction();
+    AppendClaim(transaction, loot->GetJournalEventId(), GetGUID(),
+        uint32(loot->items.size() + loot->quest_items.size()));
+    if (amount)
+    {
+        auto statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_UPD_GOLD);
+        statement->SetData(0, amount);
+        statement->SetData(1, GetGUID().GetRawValue());
+        statement->SetData(2, GetMoney());
+        transaction->Append(statement);
+        transaction->RequireLastAffectedRows(1);
+    }
+    TransactionOutcome outcome = CharacterDatabase.OrderedCommitCheckedTransaction(transaction);
+    if (outcome == TransactionOutcome::Unknown)
+        QuarantineJournalFailure();
+    if (outcome != TransactionOutcome::Committed)
+        return false;
+    SetMoney(GetMoney() + amount);
+    return true;
+}
+
+bool Player::ClaimRecoveryMailGold(uint32 mail, uint32 amount)
+{
+    if (!amount || !MoneyFits(this, amount) || !FlushJournalInventory())
+        return false;
+    auto transaction = CharacterDatabase.BeginTransaction();
+    auto statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_CLEAR_MAIL_GOLD);
+    statement->SetData(0, mail);
+    statement->SetData(1, GetGUID().GetCounter());
+    statement->SetData(2, amount);
+    transaction->Append(statement);
+    transaction->RequireLastAffectedRows(1);
+    statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_UPD_GOLD);
+    statement->SetData(0, amount);
+    statement->SetData(1, GetGUID().GetRawValue());
+    statement->SetData(2, GetMoney());
+    transaction->Append(statement);
+    transaction->RequireLastAffectedRows(1);
+    TransactionOutcome outcome = CharacterDatabase.OrderedCommitCheckedTransaction(transaction);
+    if (outcome == TransactionOutcome::Unknown)
+        QuarantineJournalFailure();
+    if (outcome != TransactionOutcome::Committed)
+        return false;
+    SetMoney(GetMoney() + amount);
+    GetMail(mail)->money = 0;
+    return true;
+}
