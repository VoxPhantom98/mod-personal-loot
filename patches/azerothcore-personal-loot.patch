+bool Loot::RestoreJournal(std::string const& eventId, std::string const& payload)
+{
+    try
+    {
+        Tree data = Parse(payload);
+        if (data.get<uint32>("version") != 1 || !data.get<bool>("personalGold"))
+            return false;
+        decltype(personalLoot) restored;
+        for (auto const& entry : data.get_child("recipients"))
+        {
+            if (restored.size() >= 40)
+                throw std::runtime_error("Too many stored recipients");
+            auto leaf = std::make_unique<Loot>();
+            leaf->isPersonalLeaf = true;
+            leaf->journalManaged = true;
+            leaf->journalCommitted = true;
+            leaf->journalEventId = eventId;
+            leaf->sourceWorldObjectGUID = sourceWorldObjectGUID;
+            leaf->sourceGameObject = sourceGameObject;
+            leaf->gold = entry.second.get<uint32>("gold");
+            leaf->unlootedCount = uint8(entry.second.get<uint32>("unlooted"));
+            ObjectGuid guid(entry.second.get<uint64>("guid"));
+            for (auto const& stored : entry.second.get_child("items"))
+            {
+                LootItem item{};
+                item.itemid = stored.second.get<uint32>("id");
+                item.count = uint8(stored.second.get<uint32>("count"));
+                item.randomPropertyId = stored.second.get<int32>("property");
+                item.randomSuffix = stored.second.get<uint32>("suffix");
+                item.rollWinnerGUID = ObjectGuid(stored.second.get<uint64>("rollWinner", 0));
+                DecodeFlags(item, stored.second.get<uint32>("flags"));
+                DecodeMetadata(item, stored.second.get_child("metadata"), leaf->journalConditions);
+                bool quest = stored.second.get<bool>("questRow");
+                auto& list = quest ? leaf->quest_items : leaf->items;
+                if (!sObjectMgr->GetItemTemplate(item.itemid) || !item.count ||
+                    list.size() >= (quest ? MAX_NR_QUEST_ITEMS : MAX_NR_LOOT_ITEMS))
+                    throw std::runtime_error("Invalid stored item");
+                list.push_back(std::move(item));
+            }
+            auto tracking = [&](char const* key, QuestItemMap& destination, std::size_t itemCount)
+            {
+                for (auto const& stored : entry.second.get_child(key))
+                {
+                    ObjectGuid owner(stored.second.get<uint64>("guid"));
+                    uint32 index = stored.second.get<uint32>("index");
+                    if (owner != guid || index >= itemCount)
+                        throw std::runtime_error("Invalid stored loot tracking");
+                    if (!destination.contains(owner))
+                        destination[owner] = new QuestItemList();
+                    destination[owner]->emplace_back(uint8(index),
+                        stored.second.get<bool>("looted"));
+                }
+            };
+            tracking("questTracking", leaf->PlayerQuestItems, leaf->quest_items.size());
+            tracking("ffaTracking", leaf->PlayerFFAItems, leaf->items.size());
+            tracking("conditionalTracking", leaf->PlayerNonQuestNonFFAConditionalItems, leaf->items.size());
+            if (!restored.emplace(guid, std::move(leaf)).second)
+                throw std::runtime_error("Duplicate stored recipient");
+        }
+        personalLoot = std::move(restored);
+        personalMoney = true;
+        journalManaged = true;
+        journalCommitted = true;
+        journalEventId = eventId;
+        gold = data.get<uint32>("rootGold");
+        lootOwnerGUID = ObjectGuid(data.get<uint64>("rootOwner"));
+        return ReconcileJournalClaims();
+    }
+    catch (std::exception const& error)
+    {
+        LOG_ERROR("module.personal_loot", "Cannot restore event {}: {}", eventId, error.what());
+        return false;
+    }
+}
+
+bool Loot::ReconcileJournalClaims()
+{
+    auto statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_SEL_CLAIMS);
+    statement->SetData(0, journalEventId);
+    statement->SetData(1, journalEventId);
+    auto claims = CharacterDatabase.Query(statement);
+    if (!claims)
+        return false;
+    do
+    {
+        Field* row = claims->Fetch();
+        auto leaf = personalLoot.find(ObjectGuid(row[0].Get<uint64>()));
+        if (leaf == personalLoot.end())
+            continue;
+        Loot& result = *leaf->second;
+        uint32 index = row[1].Get<uint32>();
+        if (index == result.items.size() + result.quest_items.size())
+        {
+            result.gold = 0;
+            continue;
+        }
+        bool quest = index >= result.items.size();
+        uint32 position = quest ? index - uint32(result.items.size()) : index;
+        auto& items = quest ? result.quest_items : result.items;
+        if (position >= items.size() || items[position].is_looted)
+            continue;
+        items[position].is_looted = true;
+        if (result.unlootedCount)
+            --result.unlootedCount;
+        auto mark = [&](QuestItemMap& tracking)
+        {
+            for (auto const& [guid, list] : tracking)
+                for (QuestItem& item : *list)
+                    if (item.index == position)
+                        item.is_looted = true;
+        };
+        if (quest)
+            mark(result.PlayerQuestItems);
+        else
+        {
+            mark(result.PlayerFFAItems);
+            mark(result.PlayerNonQuestNonFFAConditionalItems);
+        }
+    } while (claims->NextRow());
+    return true;
+}
