+namespace
+{
+    struct PendingReward
+    {
+        PendingReward() = default;
+        PendingReward(PendingReward const&) = delete;
+        PendingReward& operator=(PendingReward const&) = delete;
+        PendingReward(PendingReward&&) = default;
+        PendingReward& operator=(PendingReward&&) = default;
+        std::string event;
+        ObjectGuid owner;
+        uint32 index;
+        uint8 kind;
+        uint64 quantity;
+        bool dungeon{false};
+        LootItem item{};
+        std::vector<std::unique_ptr<Condition>> conditions;
+    };
+
+    bool ShouldMail(PendingReward const& reward, uint32 policy)
+    {
+        uint32 mode = policy & 3U;
+        if (!mode || ((mode == 3 || (policy & (1U << 6))) && !reward.dungeon))
+            return false;
+        if (reward.kind == 1)
+            return mode != 3 && (policy & (1U << 5));
+        auto proto = sObjectMgr->GetItemTemplate(reward.item.itemid);
+        if (!proto || (mode >= 2 && proto->Quality < ((policy >> 2) & 7U)))
+            return false;
+        // This profile approximates Postmaster behavior; it is not a retail compatibility claim.
+        return mode != 3 || (!reward.item.needs_quest && proto->Bonding != BIND_QUEST_ITEM &&
+            proto->Bonding != BIND_WHEN_EQUIPPED && !proto->IsCurrencyToken());
+    }
+
+    void SynchronizeMailbox(Player* player)
+    {
+        std::set<uint32> known;
+        for (Mail const* mail : player->GetMails())
+            known.insert(mail->messageID);
+        bool added = false;
+        auto statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_SEL_RECOVERY_MAIL);
+        statement->SetData(0, player->GetGUID().GetRawValue());
+        auto result = CharacterDatabase.Query(statement);
+        if (!result)
+            return;
+        do
+        {
+            Field* fields = result->Fetch();
+            uint32 id = fields[0].Get<uint32>();
+            if (known.contains(id))
+                continue;
+            auto mail = std::make_unique<Mail>();
+            mail->messageID = id;
+            mail->messageType = fields[1].Get<uint8>();
+            mail->sender = fields[2].Get<uint32>();
+            mail->receiver = fields[3].Get<uint32>();
+            mail->subject = fields[4].Get<std::string>();
+            mail->body = fields[5].Get<std::string>();
+            mail->expire_time = fields[6].Get<uint32>();
+            mail->deliver_time = fields[7].Get<uint32>();
+            mail->money = fields[8].Get<uint32>();
+            mail->COD = fields[9].Get<uint32>();
+            mail->checked = fields[10].Get<uint8>();
+            mail->stationery = fields[11].Get<uint8>();
+            mail->mailTemplateId = fields[12].Get<uint16>();
+            mail->state = MAIL_STATE_UNCHANGED;
+            std::vector<std::unique_ptr<Item>> items;
+            bool complete = true;
+            statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_SEL_RECOVERY_ITEMS);
+            statement->SetData(0, id);
+            statement->SetData(1, player->GetGUID().GetRawValue());
+            if (auto stored = CharacterDatabase.Query(statement))
+                do
+                {
+                    Field* itemRow = stored->Fetch();
+                    uint32 entry = itemRow[12].Get<uint32>();
+                    auto proto = sObjectMgr->GetItemTemplate(entry);
+                    if (!proto)
+                    {
+                        complete = false;
+                        continue;
+                    }
+                    auto item = std::unique_ptr<Item>(NewItemOrBag(proto));
+                    if (item->LoadFromDB(itemRow[11].Get<uint32>(), player->GetGUID(), itemRow, entry))
+                    {
+                        mail->AddItem(item->GetGUID().GetCounter(), entry);
+                        items.push_back(std::move(item));
+                    }
+                    else
+                        complete = false;
+                } while (stored->NextRow());
+            // A failed attachment read must not publish a permanently incomplete inbox entry.
+            if (!complete || (fields[13].Get<bool>() && items.empty()))
+                continue;
+            time_t deliver = mail->deliver_time;
+            player->AddMail(mail.release());
+            for (auto& item : items)
+                player->AddMItem(item.release());
+            player->AddNewMailDeliverTime(deliver);
+            added = true;
+        } while (result->NextRow());
+        if (added)
+            sMailMgr->RecountMailCount(player->GetGUID().GetCounter());
+    }
+
+    bool Deliver(std::vector<PendingReward>& rewards, Player* player, uint32 policy)
+    {
+        if (rewards.empty() || (player && !player->FlushJournalInventory()))
+            return false;
+        ObjectGuid owner = rewards.front().owner;
+        std::map<uint32, uint64> counts;
+        std::map<uint32, uint64> categories;
+        if (player)
+        {
+            auto statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_SEL_OWNED_COUNTS);
+            statement->SetData(0, owner.GetRawValue());
+            auto owned = CharacterDatabase.Query(statement);
+            if (!owned)
+                return false;
+            do
+            {
+                uint32 entry = uint32(owned->Fetch()[0].Get<uint64>());
+                uint64 count = owned->Fetch()[1].Get<uint64>();
+                counts[entry] = count;
+                if (auto proto = sObjectMgr->GetItemTemplate(entry))
+                    categories[proto->ItemLimitCategory] += count;
+            } while (owned->NextRow());
+        }
+        struct Envelope
+        {
+            uint32 id;
+            std::string delivery;
+            uint32 money{0};
+            std::vector<std::unique_ptr<Item>> items;
+        };
+        std::vector<Envelope> envelopes;
+        auto envelope = [&]() -> Envelope&
+        {
+            if (envelopes.empty() || envelopes.back().items.size() == MAX_MAIL_ITEMS)
+                envelopes.push_back({sObjectMgr->GenerateMailID(),
+                    ByteArrayToHexStr(Acore::Crypto::GetRandomBytes<16>()), 0, {}});
+            return envelopes.back();
+        };
+        std::vector<std::pair<PendingReward*, std::string>> selected;
+        uint32 claimed = 0;
+        for (auto& reward : rewards)
+        {
+            if (!ShouldMail(reward, policy))
+                continue;
+            if (reward.kind == 1)
+            {
+                if (reward.quantity > std::numeric_limits<uint32>::max())
+                    continue;
+                std::string delivery = envelope().delivery;
+                uint64 remaining = reward.quantity;
+                if (player && player->HasPlayerFlag(PLAYER_FLAGS_PARTIAL_PLAY_TIME))
+                    remaining /= 2;
+                while (remaining)
+                {
+                    if (envelope().money == MAX_MONEY_AMOUNT)
+                        envelopes.push_back({sObjectMgr->GenerateMailID(),
+                            ByteArrayToHexStr(Acore::Crypto::GetRandomBytes<16>()), 0, {}});
+                    uint32 amount = uint32(std::min<uint64>(remaining, MAX_MONEY_AMOUNT - envelopes.back().money));
+                    envelopes.back().money += amount;
+                    remaining -= amount;
+                }
+                selected.emplace_back(&reward, delivery);
+                ++claimed;
+                continue;
+            }
+            auto proto = sObjectMgr->GetItemTemplate(reward.item.itemid);
+            if (!proto || reward.quantity > 255)
+                continue;
+            if (!player && (reward.item.needs_quest || !reward.item.conditions.empty() ||
+                proto->MaxCount > 0 || proto->ItemLimitCategory))
+                continue; // Evaluate quest/conditional/unique eligibility on that character's map thread.
+            if (player && (!reward.item.AllowedForPlayer(player, ObjectGuid::Empty) ||
+                player->CanTakeMoreSimilarItems(reward.item.itemid, uint32(reward.quantity)) != EQUIP_ERR_OK))
+                continue;
+            if (player && proto->MaxCount > 0 &&
+                counts[reward.item.itemid] + reward.quantity > uint32(proto->MaxCount))
+                continue;
+            if (player && proto->ItemLimitCategory)
+            {
+                auto limit = sItemLimitCategoryStore.LookupEntry(proto->ItemLimitCategory);
+                if (!limit || (limit->mode == ITEM_LIMIT_CATEGORY_MODE_HAVE &&
+                    categories[proto->ItemLimitCategory] + reward.quantity > limit->maxCount))
+                    continue;
+            }
+            std::string delivery = envelope().delivery;
+            uint32 remaining = uint32(reward.quantity);
+            while (remaining)
+            {
+                uint32 count = std::min(remaining, proto->GetMaxStackSize());
+                auto item = CreateExactItem(reward.item, count, player);
+                if (!item)
+                    return false;
+                item->SetOwnerGUID(owner);
+                envelope().items.push_back(std::move(item));
+                remaining -= count;
+            }
+            selected.emplace_back(&reward, delivery);
+            counts[reward.item.itemid] += reward.quantity;
+            categories[proto->ItemLimitCategory] += reward.quantity;
+            ++claimed;
+        }
+        if (!claimed)
+            return false;
+        uint32 now = uint32(GameTime::GetGameTime().count());
+        // Outbox ownership rows precede claims because the schema checks the composite FK immediately.
+        // Build a fresh transaction so all delivery guards exist before their claims.
+        auto final = CharacterDatabase.BeginTransaction();
+        for (auto& mail : envelopes)
+        {
+            auto statement = CharacterDatabase.GetPreparedStatement(CHAR_INS_MAIL);
+            statement->SetData(0, mail.id);
+            statement->SetData(1, uint8(MAIL_NORMAL));
+            statement->SetData(2, uint8(MAIL_STATIONERY_GM));
+            statement->SetData(3, uint16(0));
+            statement->SetData(4, uint32(0));
+            statement->SetData(5, owner.GetCounter());
+            statement->SetData(6, std::string("Recovered personal loot"));
+            statement->SetData(7, std::string("Your uncollected personal rewards were saved and recovered. ") +
+                "Each reward belongs only to this character.");
+            statement->SetData(8, !mail.items.empty());
+            statement->SetData(9, std::numeric_limits<uint32>::max());
+            statement->SetData(10, now);
+            statement->SetData(11, mail.money);
+            statement->SetData(12, uint32(0));
+            statement->SetData(13, uint8(MAIL_CHECK_MASK_COPIED));
+            final->Append(statement);
+            auto delivery = CharacterDatabase.GetPreparedStatement(CHAR_PL_INS_DELIVERY);
+            delivery->SetData(0, mail.delivery);
+            delivery->SetData(1, owner.GetRawValue());
+            delivery->SetData(2, mail.id);
+            delivery->SetData(3, uint64(now));
+            delivery->SetData(4, uint64(now));
+            final->Append(delivery);
+            for (auto& item : mail.items)
+            {
+                item->SaveToDBInsertOnly(final);
+                final->RequireLastAffectedRows(1);
+                statement = CharacterDatabase.GetPreparedStatement(CHAR_INS_MAIL_ITEM);
+                statement->SetData(0, mail.id);
+                statement->SetData(1, item->GetGUID().GetCounter());
+                statement->SetData(2, owner.GetCounter());
+                final->Append(statement);
+            }
+        }
+        // Move prepared claim guards without replaying or rewriting their immutable identities.
+        for (auto const& [reward, delivery] : selected)
+            AppendClaim(final, reward->event, owner, reward->index, 1, delivery);
+        TransactionOutcome outcome = CharacterDatabase.OrderedCommitCheckedTransaction(final);
+        if (outcome == TransactionOutcome::Committed)
+        {
+            for (auto const& mail : envelopes)
+                sMailMgr->OnMailSent(owner.GetCounter());
+            LOG_DEBUG("module.personal_loot", "Recovered {} reward rows for {} into {} mail(s).",
+                claimed, owner.ToString(), envelopes.size());
+            return true;
+        }
+        // A retry selects only rows without durable claims, so an unknown commit cannot create another award.
+        LOG_ERROR("module.personal_loot", "Recovery mail outcome unconfirmed for {}; outcome={}",
+            owner.ToString(), uint32(outcome));
+        return false;
+    }
+
+    void Recover(Player* player)
+    {
+        uint32 policy = recoveryPolicy.load(std::memory_order_relaxed);
+        if (!(policy & 3U))
+            return;
+        if (!Loot::GenerationJournalEnabled() || !CharacterDatabase.HasSingleAsyncWorker())
+            return;
+        if (player && (player->HasJournalPersistenceFault() || !player->IsInWorld() ||
+            player->HasPlayerFlag(PLAYER_FLAGS_NO_PLAY_TIME)))
+            return;
+        auto statement = CharacterDatabase.GetPreparedStatement(
+            player ? CHAR_PL_SEL_PENDING_PLAYER : CHAR_PL_SEL_PENDING);
+        ObjectGuid cursorKey = player ? player->GetGUID() : ObjectGuid::Empty;
+        RecoveryCursor cursor;
+        {
+            std::lock_guard<std::mutex> guard(cursorMutex);
+            cursor = recoveryCursors[cursorKey];
+        }
+        if (player)
+        {
+            statement->SetData(0, player->GetGUID().GetRawValue());
+            statement->SetData(1, cursor.event);
+            statement->SetData(2, cursor.index);
+        }
+        else
+        {
+            statement->SetData(0, cursor.event);
+            statement->SetData(1, cursor.owner);
+            statement->SetData(2, cursor.index);
+        }
+        auto pending = CharacterDatabase.Query(statement);
+        if (!pending)
+        {
+            std::lock_guard<std::mutex> guard(cursorMutex);
+            recoveryCursors[cursorKey] = RecoveryCursor{};
+            return;
+        }
+        std::map<std::pair<std::string, uint64>, std::vector<PendingReward>> groups;
+        do
+        {
+            Field* row = pending->Fetch();
+            ObjectGuid owner(row[1].Get<uint64>());
+            cursor = {row[0].Get<std::string>(), owner.GetRawValue(), row[2].Get<uint32>()};
+            if (!player && ObjectAccessor::FindConnectedPlayer(owner))
+                continue;
+            if (!player && (row[10].Get<uint32>() & (PLAYER_FLAGS_NO_PLAY_TIME | PLAYER_FLAGS_PARTIAL_PLAY_TIME)))
+                continue;
+            try
+            {
+                PendingReward reward;
+                reward.event = row[0].Get<std::string>();
+                reward.owner = owner;
+                reward.index = row[2].Get<uint32>();
+                reward.kind = row[3].Get<uint8>();
+                reward.quantity = row[5].Get<uint64>();
+                if (auto map = sMapStore.LookupEntry(row[11].Get<uint16>()))
+                    reward.dungeon = row[12].Get<uint32>() != 0 && map->IsDungeon();
+                if (reward.kind == 0)
+                {
+                    reward.item.itemid = row[4].Get<uint32>();
+                    reward.item.count = uint8(reward.quantity);
+                    reward.item.randomPropertyId = row[6].Get<int32>();
+                    reward.item.randomSuffix = row[7].Get<uint32>();
+                    DecodeFlags(reward.item, row[8].Get<uint32>());
+                    DecodeMetadata(reward.item, Parse(row[9].Get<std::string>()), reward.conditions);
+                }
+                // Skip filtered rows before baseline inventory saves or per-event ownership queries.
+                if (ShouldMail(reward, policy))
+                    groups[{reward.event, owner.GetRawValue()}].push_back(std::move(reward));
+            }
+            catch (std::exception const& error)
+            {
+                LOG_ERROR("module.personal_loot", "Invalid pending reward for {}: {}", owner.ToString(), error.what());
+            }
+        } while (pending->NextRow());
+        {
+            std::lock_guard<std::mutex> guard(cursorMutex);
+            recoveryCursors[cursorKey] = cursor;
+        }
+        for (auto& [key, rewards] : groups)
+            Deliver(rewards, player, policy);
+    }
+}
+
+void PersonalLootPersistence::ConfigureRecovery(uint32 mode, uint32 minQuality, bool gold, bool instancesOnly)
+{
+    if (mode > 3 || minQuality > 7)
+    {
+        LOG_ERROR("module.personal_loot", "Invalid recovery settings; previous recovery policy retained.");
+        return;
+    }
+    recoveryPolicy.store(mode | (minQuality << 2) | (uint32(gold) << 5) | (uint32(instancesOnly) << 6),
+        std::memory_order_relaxed);
+    LOG_INFO("module.personal_loot", "Recovery mail: mode={}, minQuality={}, gold={}, instancesOnly={}",
+        mode, minQuality, mode != 3 && gold, mode == 3 || instancesOnly);
+}
+
+void PersonalLootPersistence::RecoverStartup()
+{
+    if (!Loot::GenerationJournalEnabled())
+        return;
+    auto transaction = CharacterDatabase.BeginTransaction();
+    transaction->Append(CharacterDatabase.GetPreparedStatement(CHAR_PL_ORPHAN_ALL));
+    if (CharacterDatabase.OrderedCommitCheckedTransaction(transaction) != TransactionOutcome::Committed)
+    {
+        LOG_FATAL("module.personal_loot", "Could not establish startup loot recovery state.");
+        throw std::runtime_error("Personal loot startup reconciliation failed");
+    }
+    Recover(nullptr);
+}
+
+void PersonalLootPersistence::RecoverOffline()
+{
+    Recover(nullptr);
+}
+
+void PersonalLootPersistence::RecoverPlayer(Player* player)
+{
+    Recover(player);
+    SynchronizeMailbox(player);
+}
+
+int PersonalLootPersistence::RecoveryMailStatus(Player* player, uint32 id)
+{
+    if (!Loot::GenerationJournalEnabled())
+        return 0;
+    auto statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_MAIL_STATUS);
+    statement->SetData(0, id);
+    statement->SetData(1, player->GetGUID().GetRawValue());
+    auto result = CharacterDatabase.Query(statement);
+    return result ? int(result->Fetch()[0].Get<uint8>()) : -1;
+}
+
+void PersonalLootPersistence::ForgetPlayer(Player* player)
+{
+    std::lock_guard<std::mutex> guard(cursorMutex);
+    recoveryCursors.erase(player->GetGUID());
+}
+
+void Player::UpdateJournalRecovery(uint32 diff)
+{
+    if (!Loot::GenerationJournalEnabled() || m_journalPersistenceFault)
+        return;
+    if (m_journalRecoveryTimer > diff)
+    {
+        m_journalRecoveryTimer -= diff;
+        return;
+    }
+    m_journalRecoveryTimer = 15000;
+    PersonalLootPersistence::RecoverPlayer(this);
+}
