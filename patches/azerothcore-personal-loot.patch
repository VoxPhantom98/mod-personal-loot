+void Player::QuarantineJournalFailure()
+{
+    m_journalPersistenceFault = true;
+    LOG_ERROR("module.personal_loot", "Character {} disconnected after an uncertain inventory save/claim; "
+        "reload durable state before further play.", GetGUID().ToString());
+    GetSession()->KickPlayer("Personal loot persistence reconciliation");
+}
