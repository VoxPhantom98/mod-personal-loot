+        statement->SetData(0, instanceId);
+        return CharacterDatabase.Query(statement);
+    };
+    auto accept = [&](PreparedQueryResult const& row)
+    {
+        if (!row || row->Fetch()[1].Get<uint32>() != mapId || row->Fetch()[2].Get<uint8>() != difficulty)
+            return false;
+        journalInstanceCycles[instanceId] = row->Fetch()[0].Get<std::string>();
+        return true;
+    };
+    if (loaded && accept(read()))
+        return;
+    std::string cycle = ByteArrayToHexStr(Acore::Crypto::GetRandomBytes<16>());
+    auto transaction = CharacterDatabase.BeginTransaction();
+    auto statement = CharacterDatabase.GetPreparedStatement(
+        loaded ? CHAR_PL_INS_INSTANCE_CYCLE : CHAR_PL_REP_INSTANCE_CYCLE);
+    statement->SetData(0, instanceId);
+    statement->SetData(1, cycle);
+    statement->SetData(2, mapId);
+    statement->SetData(3, difficulty);
+    transaction->Append(statement);
+    CharacterDatabase.DirectCommitCheckedTransaction(transaction);
+    auto confirmed = read();
+    if (confirmed && confirmed->Fetch()[0].Get<std::string>() == cycle)
+        accept(confirmed);
+    else
+        LOG_ERROR("module.personal_loot", "Instance {} journal cycle could not be confirmed; rewards blocked.",
+            instanceId);
+}
+
+bool Loot::JournalPersonalLoot(WorldObject* source, uint16 lootMode)
+{
+    if (!journalManaged)
+        return true;
+    if (journalCommitted)
+        return ReconcileJournalClaims();
+    if (!source || !personalMoney)
+        return false; // Shared gold requires a separate ownership policy, never duplicate it into leaves.
+
+    Creature* creature = source->ToCreature();
+    GameObject* chest = source->ToGameObject();
+    if (!creature && !chest)
+        return false;
+    if (journalEventId.empty())
+    {
+        journalLootMode = lootMode;
+        auto random = Acore::Crypto::GetRandomBytes<16>();
+        std::ostringstream id;
+        id << std::hex << std::setfill('0');
+        for (uint8 byte : random)
+            id << std::setw(2) << uint32(byte);
+        journalEventId = id.str();
+        std::ostringstream key;
+        if (source->GetInstanceId() && (chest || creature->IsDungeonBoss()))
+        {
+            std::lock_guard<std::mutex> guard(journalCycleMutex);
+            std::string const& cycle = journalInstanceCycles[source->GetInstanceId()];
+            if (cycle.empty())
+            {
+                journalEventId.clear();
+                return false;
+            }
+            key << "instance:" << source->GetMapId() << ':' << cycle << ':'
+                << uint32(source->GetMap()->GetSpawnMode()) << ':' << (chest ? 'g' : 'c') << ':'
+                << source->GetEntry() << ':' << (chest ? chest->GetSpawnId() : creature->GetSpawnId());
+        }
+        else
+            key << "occurrence:" << journalEventId;
+        journalSourceKey = key.str();
+    }
+
+    auto readExisting = [&]()
+    {
+        auto statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_SEL_SNAPSHOT);
+        statement->SetData(0, journalSourceKey);
+        return CharacterDatabase.Query(statement);
+    };
+    if (auto existing = readExisting())
+    {
+        std::string expected = journalEventId;
+        std::transform(expected.begin(), expected.end(), expected.begin(), [](unsigned char value)
+        {
+            return static_cast<char>(std::toupper(value));
+        });
+        // The same operation may have committed without an acknowledgement.
+        journalCommitted = existing->Fetch()[0].Get<std::string>() == expected &&
+            existing->Fetch()[1].Get<uint32>() == 1;
+        if (!journalCommitted)
+            return RestoreJournal(existing->Fetch()[0].Get<std::string>(), existing->Fetch()[2].Get<std::string>());
+        for (auto const& [guid, result] : personalLoot)
+        {
+            result->journalEventId = journalEventId;
+            result->journalCommitted = true;
+        }
+        return ReconcileJournalClaims();
+    }
+    if (!HasPersonalLoot())
+        return false;
+
+    auto transaction = CharacterDatabase.BeginTransaction();
+    uint64 now = static_cast<uint64>(GameTime::GetGameTime().count());
+    auto event = CharacterDatabase.GetPreparedStatement(CHAR_PL_INS_EVENT);
+    event->SetData(0, journalEventId);
+    event->SetData(1, journalSourceKey);
+    event->SetData(2, uint8(chest ? 1 : 0));
+    event->SetData(3, source->GetEntry());
+    event->SetData(4, chest ? chest->GetSpawnId() : creature->GetSpawnId());
+    event->SetData(5, source->GetMapId());
+    event->SetData(6, source->GetInstanceId());
+    event->SetData(7, source->GetMap()->GetSpawnMode());
+    event->SetData(8, journalLootMode);
+    event->SetData(9, now);
+    transaction->Append(event);
+
+    std::ostringstream snapshot;
+    snapshot << "{\"version\":1,\"sourceGuid\":" << source->GetGUID().GetRawValue()
+             << ",\"rootOwner\":" << lootOwnerGUID.GetRawValue() << ",\"rootGold\":" << gold
+             << ",\"personalGold\":true,\"recipients\":[";
+    bool firstRecipient = true;
+    for (auto const& [guid, result] : personalLoot)
+    {
+        auto recipient = CharacterDatabase.GetPreparedStatement(CHAR_PL_INS_RECIPIENT);
+        recipient->SetData(0, journalEventId);
+        recipient->SetData(1, guid.GetRawValue());
+        recipient->SetData(2, result->journalAccountId);
+        recipient->SetData(3, std::string("{\"version\":1,\"frozenAtGeneration\":true,\"characterCreatedAt\":") +
+            std::to_string(result->journalCharacterCreatedAt) + '}');
+        recipient->SetData(4, uint8(1));
+        transaction->Append(recipient);
+
+        if (!firstRecipient)
+            snapshot << ',';
+        firstRecipient = false;
+        snapshot << "{\"guid\":" << guid.GetRawValue() << ",\"gold\":" << result->gold
+                 << ",\"unlooted\":" << uint32(result->unlootedCount) << ",\"items\":[";
+        uint32 index = 0;
+        bool firstItem = true;
+        auto appendItem = [&](LootItem& item, bool quest)
+        {
+            bool eligible = item.allowedGUIDs.contains(guid);
+            if (!quest && item.freeforall)
+                if (auto tracked = result->PlayerFFAItems.find(guid); tracked != result->PlayerFFAItems.end())
+                    eligible = std::any_of(tracked->second->begin(), tracked->second->end(),
+                        [&](QuestItem const& row) { return row.index == item.itemIndex; });
+            if (!eligible)
+                item.is_looted = true; // Hidden rolls never become later entitlements through a quest/faction change.
+            std::string metadata = JournalItemMetadata(item, eligible);
+            auto reward = CharacterDatabase.GetPreparedStatement(CHAR_PL_INS_REWARD);
+            reward->SetData(0, journalEventId);
+            reward->SetData(1, guid.GetRawValue());
+            reward->SetData(2, index++);
+            reward->SetData(3, uint8(0));
+            reward->SetData(4, item.itemid);
+            reward->SetData(5, eligible ? uint64(item.count) : uint64(0));
+            reward->SetData(6, item.randomPropertyId);
+            reward->SetData(7, item.randomSuffix);
+            reward->SetData(8, JournalItemFlags(item));
+            reward->SetData(9, metadata);
+            transaction->Append(reward);
+            if (!firstItem)
+                snapshot << ',';
+            firstItem = false;
+            snapshot << "{\"questRow\":" << quest << ",\"id\":" << item.itemid << ",\"count\":"
+                     << uint32(item.count) << ",\"property\":" << item.randomPropertyId << ",\"suffix\":"
+                     << item.randomSuffix << ",\"flags\":" << JournalItemFlags(item)
+                     << ",\"rollWinner\":" << item.rollWinnerGUID.GetRawValue()
+                     << ",\"metadata\":" << metadata << '}';
+        };
+        for (LootItem& item : result->items)
+            appendItem(item, false);
+        for (LootItem& item : result->quest_items)
+            appendItem(item, true);
+        auto money = CharacterDatabase.GetPreparedStatement(CHAR_PL_INS_REWARD);
+        money->SetData(0, journalEventId);
+        money->SetData(1, guid.GetRawValue());
+        money->SetData(2, index);
+        money->SetData(3, uint8(1));
+        money->SetData(4, nullptr);
+        money->SetData(5, uint64(result->gold));
+        money->SetData(6, int32(0));
+        money->SetData(7, uint32(0));
+        money->SetData(8, uint32(0));
+        money->SetData(9, std::string("{}"));
+        transaction->Append(money);
+        snapshot << ']';
+        auto appendTracking = [&](char const* name, QuestItemMap const& tracking)
+        {
+            snapshot << ",\"" << name << "\":[";
+            bool first = true;
+            for (auto const& [playerGuid, list] : tracking)
+                if (list)
+                    for (QuestItem const& entry : *list)
+                    {
+                        if (!first)
+                            snapshot << ',';
+                        first = false;
+                        snapshot << "{\"guid\":" << playerGuid.GetRawValue() << ",\"index\":"
+                                 << uint32(entry.index) << ",\"looted\":" << entry.is_looted << '}';
+                    }
+            snapshot << ']';
+        };
+        appendTracking("questTracking", result->PlayerQuestItems);
+        appendTracking("ffaTracking", result->PlayerFFAItems);
+        appendTracking("conditionalTracking", result->PlayerNonQuestNonFFAConditionalItems);
+        snapshot << '}';
+    }
+    snapshot << "]}";
+    auto saved = CharacterDatabase.GetPreparedStatement(CHAR_PL_INS_SNAPSHOT);
+    saved->SetData(0, journalEventId);
+    saved->SetData(1, snapshot.str());
+    transaction->Append(saved);
+    auto ready = CharacterDatabase.GetPreparedStatement(CHAR_PL_MARK_READY);
+    ready->SetData(0, now);
+    ready->SetData(1, journalEventId);
+    transaction->Append(ready);
+
+    TransactionOutcome outcome = CharacterDatabase.DirectCommitCheckedTransaction(transaction);
+    journalCommitted = outcome == TransactionOutcome::Committed;
+    if (journalCommitted)
+        for (auto const& [guid, result] : personalLoot)
+        {
+            result->journalEventId = journalEventId;
+            result->journalCommitted = true;
+        }
+    if (!journalCommitted)
+        LOG_ERROR("module.personal_loot", "Loot journal commit not confirmed for event {}; outcome={}",
+            journalEventId, uint32(outcome));
+    return journalCommitted;
+}
+
+bool Loot::empty() const
+{
+    if (!items.empty() || gold != 0)
+        return false;
+
+    for (auto const& [guid, result] : personalLoot)
+        if (!result->isLooted())
+            return false;
+
+    return true;
+}
+
+bool Loot::isLooted() const
+{
+    if (gold != 0 || unlootedCount != 0)
+        return false;
+
+    for (auto const& [guid, result] : personalLoot)
+        if (!result->isLooted())
+            return false;
+
+    return true;
+}
+
+Loot* Loot::GetPersonalLoot(ObjectGuid playerGuid)
+{
+    if (personalLoot.empty())
+        return this;
+
+    auto itr = personalLoot.find(playerGuid);
+    return itr != personalLoot.end() ? itr->second.get() : nullptr;
+}
+
+Loot const* Loot::GetPersonalLoot(ObjectGuid playerGuid) const
+{
+    if (personalLoot.empty())
+        return this;
+
+    auto itr = personalLoot.find(playerGuid);
+    return itr != personalLoot.end() ? itr->second.get() : nullptr;
+}
