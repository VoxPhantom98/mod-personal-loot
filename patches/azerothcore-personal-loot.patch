+TransactionOutcome MySQLConnection::ExecuteCheckedTransaction(
+    std::shared_ptr<TransactionBase> const& transaction)
+{
+    if (!transaction || transaction->m_queries.empty() || m_checkedTransaction)
+        return TransactionOutcome::Unknown;
+
+    struct ReplayGuard
+    {
+        bool& checked;
+        explicit ReplayGuard(bool& value) : checked(value) { checked = true; }
+        ~ReplayGuard() { checked = false; }
+    } guard(m_checkedTransaction);
+
+    return RunCheckedTransaction([this](std::string_view command) { return Execute(command); }, [&]()
+    {
+        for (std::size_t index = 0; index < transaction->m_queries.size(); ++index)
+        {
+            auto const& data = transaction->m_queries[index];
+            bool executed = data.type == SQL_ELEMENT_PREPARED ?
+                Execute(std::get<PreparedStatementBase*>(data.element)) :
+                Execute(std::get<std::string>(data.element));
+            if (!executed)
+                return false;
+            if (auto expected = transaction->m_requiredAffectedRows.find(index);
+                expected != transaction->m_requiredAffectedRows.end())
+            {
+                uint64 affected = data.type == SQL_ELEMENT_PREPARED ?
+                    mysql_stmt_affected_rows(GetPreparedStatement(
+                        std::get<PreparedStatementBase*>(data.element)->GetIndex())->GetSTMT()) :
+                    mysql_affected_rows(m_Mysql);
+                if (affected != expected->second)
+                    return false;
+            }
+        }
+        return true;
+    });
+}
