+bool Player::FlushJournalInventory()
+{
+    if (m_journalPersistenceFault || IsBeingTeleportedFar() || !CharacterDatabase.HasSingleAsyncWorker())
+        return false;
+    auto transaction = CharacterDatabase.BeginTransaction();
+    SaveInventoryAndGoldToDB(transaction);
+    if (CharacterDatabase.OrderedCommitCheckedTransaction(transaction) == TransactionOutcome::Committed)
+        return true;
+    QuarantineJournalFailure();
+    return false;
+}
