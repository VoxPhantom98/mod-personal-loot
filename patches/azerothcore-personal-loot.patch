+template <class T>
+TransactionOutcome DatabaseWorkerPool<T>::DirectCommitCheckedTransaction(SQLTransaction<T> const& transaction)
+{
+    if (!transaction || transaction->GetSize() == 0)
+        return TransactionOutcome::Unknown;
+
+    T* connection = GetFreeConnection();
+    TransactionOutcome outcome = connection->ExecuteCheckedTransaction(transaction);
+    transaction->Cleanup();
+    connection->Unlock();
+    return outcome;
+}
+
 template <class T>
 PreparedStatement<T>* DatabaseWorkerPool<T>::GetPreparedStatement(PreparedStatementIndex index)
 {
     return new PreparedStatement<T>(index, _preparedStatementSize[index]);
 }
 
+template <class T>
+TransactionOutcome DatabaseWorkerPool<T>::OrderedCommitCheckedTransaction(SQLTransaction<T> const& transaction)
+{
+    if (!transaction || transaction->GetSize() == 0 || !HasSingleAsyncWorker())
+        return TransactionOutcome::Unknown;
+    auto task = new CheckedTransactionTask(transaction);
+    auto result = task->GetFuture();
+    Enqueue(task);
+    return result.get();
+}
