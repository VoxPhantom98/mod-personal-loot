diff --git a/src/server/database/Database/CheckedTransaction.h b/src/server/database/Database/CheckedTransaction.h
new file mode 100644
index 000000000..466852539
--- /dev/null
+++ b/src/server/database/Database/CheckedTransaction.h
@@ -0,0 +1,35 @@
+/* Voxville persistence infrastructure, GNU AGPL v3. */
+#ifndef AC_CHECKED_TRANSACTION_H
+#define AC_CHECKED_TRANSACTION_H
+
+#include <string_view>
+
+enum class TransactionOutcome
+{
+    Committed,
+    RolledBack,
+    Unknown
+};
+
+// InnoDB DML only. Callbacks must never reconnect or replay statements.
+// Unknown requires reconciliation by a durable operation ID before retrying.
+template<class Control, class Statements>
+TransactionOutcome RunCheckedTransaction(Control&& control, Statements&& statements)
+{
+    if (!control(std::string_view("START TRANSACTION")))
+        return TransactionOutcome::Unknown;
+
+    if (!statements())
+        return control(std::string_view("ROLLBACK")) ?
+            TransactionOutcome::RolledBack : TransactionOutcome::Unknown;
+
+    if (control(std::string_view("COMMIT")))
+        return TransactionOutcome::Committed;
+
+    // COMMIT may have reached the server even if acknowledgement was lost.
+    // A successful subsequent rollback cannot establish that it did not commit.
+    control(std::string_view("ROLLBACK"));
+    return TransactionOutcome::Unknown;
+}
+
+#endif
