+
+    bool MoneyFits(Player const* player, uint32 amount)
+    {
+        if (amount > MAX_MONEY_AMOUNT - player->GetMoney())
+            return false;
+        uint32 trial = sWorld->getIntConfig(CONFIG_TRIAL_MONEY_CAP);
+        return !trial || !player->GetSession()->IsTrialAccount() || player->GetMoney() + amount <= trial;
+    }
+
+    Tree Parse(std::string const& json)
+    {
+        Tree tree;
+        std::istringstream stream(json);
+        boost::property_tree::read_json(stream, tree);
+        return tree;
+    }
+
+    void DecodeMetadata(LootItem& item, Tree const& data, std::vector<std::unique_ptr<Condition>>& owned)
+    {
+        item.itemIndex = data.get<uint32>("itemIndex");
+        item.groupid = uint8(data.get<uint32>("group"));
+        for (auto const& entry : data.get_child("allowed"))
+            item.allowedGUIDs.insert(ObjectGuid(entry.second.get_value<uint64>()));
+        for (auto const& entry : data.get_child("conditions"))
+        {
+            std::vector<int64> values;
+            for (auto const& field : entry.second)
+                values.push_back(field.second.get_value<int64>());
+            if (values.size() != 15)
+                throw std::runtime_error("Invalid stored condition");
+            auto condition = std::make_unique<Condition>();
+            condition->SourceType = ConditionSourceType(values[0]);
+            condition->SourceGroup = uint32(values[1]);
+            condition->SourceEntry = int32(values[2]);
+            condition->SourceId = uint32(values[3]);
+            condition->ElseGroup = uint32(values[4]);
+            condition->ConditionType = ConditionTypes(values[5]);
+            condition->ConditionValue1 = uint32(values[6]);
+            condition->ConditionValue2 = uint32(values[7]);
+            condition->ConditionValue3 = uint32(values[8]);
+            condition->ErrorType = uint32(values[9]);
+            condition->ErrorTextId = uint32(values[10]);
+            condition->ReferenceId = uint32(values[11]);
+            condition->ScriptId = uint32(values[12]);
+            condition->ConditionTarget = uint8(values[13]);
+            condition->NegativeCondition = values[14] != 0;
+            item.conditions.push_back(condition.get());
+            owned.push_back(std::move(condition));
+        }
+    }
+
+    void DecodeFlags(LootItem& item, uint32 flags)
+    {
+        item.is_looted = flags & 1;
+        item.is_blocked = (flags >> 1) & 1;
+        item.freeforall = (flags >> 2) & 1;
+        item.is_underthreshold = (flags >> 3) & 1;
+        item.is_counted = (flags >> 4) & 1;
+        item.needs_quest = (flags >> 5) & 1;
+        item.follow_loot_rules = (flags >> 6) & 1;
+    }
+
+    void AppendClaim(CharacterDatabaseTransaction const& transaction, std::string const& event,
+        ObjectGuid owner, uint32 index, uint8 kind = 0, std::string const& delivery = {}, uint32 itemGuid = 0)
+    {
+        auto statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_INS_CLAIM);
+        statement->SetData(0, index);
+        statement->SetData(1, kind);
+        if (delivery.empty())
+            statement->SetData(2, nullptr);
+        else
+            statement->SetData(2, delivery);
+        if (itemGuid)
+            statement->SetData(3, itemGuid);
+        else
+            statement->SetData(3, nullptr);
+        statement->SetData(4, uint64(GameTime::GetGameTime().count()));
+        statement->SetData(5, event);
+        statement->SetData(6, owner.GetRawValue());
+        statement->SetData(7, index);
+        transaction->Append(statement);
+        transaction->RequireLastAffectedRows(1);
+    }
+
+    std::unique_ptr<Item> CreateExactItem(LootItem const& reward, uint32 count, Player const* player)
+    {
+        auto item = std::unique_ptr<Item>(Item::CreateItem(reward.itemid, count, nullptr, true,
+            reward.randomPropertyId));
+        if (!item || item->GetCount() != count)
+            return nullptr;
+        if (reward.randomPropertyId < 0)
+            item->SetUInt32Value(ITEM_FIELD_PROPERTY_SEED, reward.randomSuffix);
+        auto bonding = item->GetTemplate()->Bonding;
+        if (bonding == BIND_WHEN_PICKED_UP || bonding == BIND_QUEST_ITEM)
+            item->SetBinding(true);
+        if (player)
+            item->SetOwnerGUID(player->GetGUID());
+        return item;
+    }
+}
