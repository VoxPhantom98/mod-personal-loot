+void GameObject::PreparePersonalJournalLoot()
+{
+    if (!Loot::GenerationJournalEnabled() || GetGoType() != GAMEOBJECT_TYPE_CHEST ||
+        !HasLootRecipient() || loot.HasPersonalLoot())
+        return;
+    static bool const bossChests = sConfigMgr->GetOption<bool>("PersonalLoot.BossChests", true);
+    if (!bossChests)
+        return;
+    Player* owner = GetLootRecipient();
+    if (!owner)
+        for (ObjectGuid guid : GetAllowedLooters())
+            if ((owner = ObjectAccessor::FindConnectedPlayer(guid)))
+                break;
+    if (!owner || owner->GetMap() != GetMap() || !GetGOInfo()->GetLootId())
+        return;
+    loot.FillLoot(GetGOInfo()->GetLootId(), LootTemplates_Gameobject, owner, true, false, GetLootMode(), this);
+    if (!loot.HasPersonalLoot())
+        return;
+    if (auto addon = GetTemplateAddon())
+        loot.generateMoneyLoot(addon->mingold, addon->maxgold);
+    SetLootGenerationTime();
+    loot.JournalPersonalLoot(this, GetLootMode());
 }
 
