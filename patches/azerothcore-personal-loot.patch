+uint32 Loot::JournalRewardIndex(LootItem const* item) const
+{
+    for (uint32 index = 0; index < items.size(); ++index)
+        if (&items[index] == item)
+            return index;
+    for (uint32 index = 0; index < quest_items.size(); ++index)
+        if (&quest_items[index] == item)
+            return uint32(items.size()) + index;
+    throw std::logic_error("Item is not part of journal loot");
