+Item* Player::StoreJournalLootItem(Loot* loot, LootItem* reward, ItemPosCountVec const& dest,
+    uint32 recoveryMail, Item* original)
+{
+    if ((!original && (!loot || loot->GetJournalEventId().empty())) || !FlushJournalInventory())
+        return nullptr;
+    struct Placement
+    {
+        uint16 position;
+        uint32 count;
+        Item* stack;
+        uint32 flags;
+        std::unique_ptr<Item> created;
+    };
+    std::vector<Placement> placements;
+    auto transaction = CharacterDatabase.BeginTransaction();
+    if (original)
+    {
+        auto statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_DEL_MAIL_ITEM);
+        statement->SetData(0, recoveryMail);
+        statement->SetData(1, original->GetGUID().GetCounter());
+        statement->SetData(2, GetGUID().GetCounter());
+        transaction->Append(statement);
+        transaction->RequireLastAffectedRows(1);
+        statement = CharacterDatabase.GetPreparedStatement(CHAR_DEL_ITEM_INSTANCE);
+        statement->SetData(0, original->GetGUID().GetCounter());
+        transaction->Append(statement);
+        transaction->RequireLastAffectedRows(1);
+        statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_UPD_MAIL_ITEMS);
+        statement->SetData(0, recoveryMail);
+        statement->SetData(1, recoveryMail);
+        statement->SetData(2, GetGUID().GetCounter());
+        transaction->Append(statement);
+    }
+    else
+        AppendClaim(transaction, loot->GetJournalEventId(), GetGUID(), loot->JournalRewardIndex(reward));
+    for (auto const& destination : dest)
+    {
+        uint8 bagSlot = destination.pos >> 8;
+        uint8 slot = destination.pos & 255;
+        Item* stack = GetItemByPos(bagSlot, slot);
+        if (stack)
+        {
+            uint32 flags = stack->GetUInt32Value(ITEM_FIELD_FLAGS);
+            if (stack->GetTemplate()->Bonding == BIND_WHEN_PICKED_UP ||
+                stack->GetTemplate()->Bonding == BIND_QUEST_ITEM)
+                flags |= ITEM_FIELD_FLAG_SOULBOUND;
+            auto statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_UPD_STACK);
+            statement->SetData(0, destination.count);
+            statement->SetData(1, flags);
+            statement->SetData(2, stack->GetGUID().GetCounter());
+            statement->SetData(3, GetGUID().GetRawValue());
+            statement->SetData(4, stack->GetCount());
+            transaction->Append(statement);
+            transaction->RequireLastAffectedRows(1);
+            placements.push_back({destination.pos, destination.count, stack, flags, nullptr});
+            continue;
+        }
+        auto created = CreateExactItem(*reward, destination.count, this);
+        if (!created)
+            return nullptr;
+        if (original)
+        {
+            for (uint32 field = OBJECT_END; field < ITEM_END; ++field)
+                created->SetUInt32Value(field, original->GetUInt32Value(field));
+            created->SetCount(destination.count);
+            created->SetOwnerGUID(GetGUID());
+        }
+        AllowedLooterSet looters = reward->GetAllowedLooters();
+        if (looters.size() > 1 && created->GetTemplate()->GetMaxStackSize() == 1 && created->IsSoulBound() &&
+            sWorld->getBoolConfig(CONFIG_SET_BOP_ITEM_TRADEABLE))
+        {
+            created->SetSoulboundTradeable(looters);
+            created->SetUInt32Value(ITEM_FIELD_CREATE_PLAYED_TIME, GetTotalPlayedTime());
+            std::ostringstream allowed;
+            for (ObjectGuid guid : looters)
+                allowed << guid.GetCounter() << ' ';
+            auto trade = CharacterDatabase.GetPreparedStatement(CHAR_INS_ITEM_BOP_TRADE);
+            trade->SetData(0, created->GetGUID().GetCounter());
+            trade->SetData(1, allowed.str());
+            transaction->Append(trade);
+        }
+        created->SaveToDBInsertOnly(transaction);
+        transaction->RequireLastAffectedRows(1);
+        uint32 container = bagSlot == INVENTORY_SLOT_BAG_0 ? 0 : GetBagByPos(bagSlot)->GetGUID().GetCounter();
+        auto statement = CharacterDatabase.GetPreparedStatement(CHAR_PL_INS_INVENTORY);
+        statement->SetData(0, GetGUID().GetRawValue());
+        statement->SetData(1, container);
+        statement->SetData(2, slot);
+        statement->SetData(3, created->GetGUID().GetCounter());
+        statement->SetData(4, GetGUID().GetRawValue());
+        statement->SetData(5, container);
+        statement->SetData(6, slot);
+        transaction->Append(statement);
+        transaction->RequireLastAffectedRows(1);
+        placements.push_back({destination.pos, destination.count, nullptr, 0, std::move(created)});
+    }
+    TransactionOutcome outcome = CharacterDatabase.OrderedCommitCheckedTransaction(transaction);
+    if (outcome != TransactionOutcome::Committed)
+    {
+        if (outcome == TransactionOutcome::Unknown)
+            QuarantineJournalFailure();
+        return nullptr;
+    }
+    Item* last = nullptr;
+    for (auto& placement : placements)
+    {
+        if (placement.stack)
+        {
+            last = placement.stack;
+            last->SetCount(last->GetCount() + placement.count);
+            last->SetUInt32Value(ITEM_FIELD_FLAGS, placement.flags);
+            last->SetState(ITEM_CHANGED, this);
+            last->SendUpdateToPlayer(this);
+        }
+        else
+        {
+            last = _StoreItem(placement.position, placement.created.release(), placement.count, false, true);
+            if (last->IsBOPTradable())
+                AddTradeableItem(last);
+        }
+    }
+    ItemAddedQuestCheck(reward->itemid, reward->count);
+    UpdateAchievementCriteria(ACHIEVEMENT_CRITERIA_TYPE_RECEIVE_EPIC_ITEM, reward->itemid, reward->count);
+    UpdateAchievementCriteria(ACHIEVEMENT_CRITERIA_TYPE_OWN_ITEM, reward->itemid, reward->count);
+    if (original)
+    {
+        GetMail(recoveryMail)->RemoveItem(original->GetGUID().GetCounter());
+        RemoveMItem(original->GetGUID().GetCounter());
+        delete original;
+        sScriptMgr->OnPlayerAfterMoveItemToInventory(this, last, true);
+    }
+    else
+        sScriptMgr->OnPlayerStoreNewItem(this, last, reward->count);
+    return last;
+}
